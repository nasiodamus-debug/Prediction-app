# Copy this file to config.env and fill in the values. config.env is NEVER committed (see .gitignore).
# Every setting is explained in Readme.md.
# from @BotFather
TELEGRAM_BOT_TOKEN=
# your chat id
TELEGRAM_ADMIN_CHAT_ID=
# login phone
SPORTYBET_PHONE=
# login password
SPORTYBET_PASSWORD=
# your Telegram user id (only you can use the bot)
OWNER_ID=
# true = never place; see the README
DRY_RUN=
# gemini,claude (tried in order)
ANALYST_PROVIDER=
# API-Football (injuries, lineups)
API_FOOTBALL_KEY=
# Claude analyst
ANTHROPIC_API_KEY=
# Gemini analyst
GEMINI_API_KEY=
# web search for the Gemini analyst
SERPER_API_KEY=
# analyst calls per Lagos day
ANALYST_DAILY_CALL_LIMIT=
# Claude (paid, last tier) lookups per request; 0 = never (default 10)
CLAUDE_CALL_LIMIT=
# true: ask Claude even when Gemini found nothing for a game (default false)
CLAUDE_AFTER_EMPTY=
# distinct players out before the key_player_out flag (default 5)
KEY_PLAYERS_OUT_MIN=
# true/false
SHOW_BROWSER=
# standard or real
BROWSER_MODE=
# seconds to wait after Place
PLACE_WAIT_SECONDS=
